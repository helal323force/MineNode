# MineNode Environment Configuration

# Server Port (Render & Railway inject this automatically)
PORT=3000
NODE_ENV=production

# Admin Email (Authorized for moderation)
ADMIN_EMAIL=wingxmc26@gmail.com

# Firebase Admin Service Account Key (JSON string)
# REQUIRED for Firestore and Storage access from the backend on Render/Railway.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# Optional: Default platform limits
DEFAULT_BOT_LIMIT=3
DEFAULT_FEATURE_LIMIT=5

# Optional: Microsoft Official OAuth Client ID
MICROSOFT_CLIENT_ID=00000000402b5328

# Public Firebase Config (Usually provided by firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
